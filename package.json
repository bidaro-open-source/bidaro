{
  "type": "module",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "git config core.hooksPath .hooks",
    "postinstall": "nuxt prepare",
    "test": "bun --env-file=.env.test vitest run",
    "test:api": "bun --env-file=.env.test vitest run test/api",
    "test:unit": "bun --env-file=.env.test vitest run test/unit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "db": "bun run db:undo && bun run db:migrate && bun run db:seed",
    "db:undo": "bun server/database/seeds down --to 0 && bun server/database/migrations down --to 0",
    "db:seed": "bun server/database/seeds up",
    "db:migrate": "bun server/database/migrations up",
    "db:seed:create": "bun server/database/seeds create --name",
    "db:migrate:create": "bun server/database/migrations create --name"
  },
  "dependencies": {
    "@bg-dev/nuxt-s3": "^2.0.2",
    "ajv": "^8.17.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "nuxt": "^3.16.2",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "uuid": "11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.11.0",
    "@nuxt/test-utils": "^3.17.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.24.0",
    "eslint-plugin-format": "^1.0.1",
    "happy-dom": "15.11.6",
    "lint-staged": "^15.5.0",
    "playwright-core": "^1.51.1",
    "vitest": "^3.1.1"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
