{
  "type": "module",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "git config core.hooksPath .hooks",
    "postinstall": "nuxt prepare",
    "test": "bun --env-file=.env run db:reset && bun --env-file=.env vitest run",
    "lint": "eslint --cache .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "db": "bun run db:reset && bun run db:seed",
    "db:reset": "bun run db:undo && bun run db:migrate",
    "db:undo": "bun run db:undo:seed && bun run db:undo:migrate",
    "db:undo:seed": "bun server/database/console/seeder-cli down --to 0",
    "db:undo:migrate": "bun server/database/console/migrator-cli down --to 0",
    "db:seed": "bun server/database/console/seeder-cli up",
    "db:migrate": "bun server/database/console/migrator-cli up",
    "db:create:seed": "bun server/database/console/seeder-cli create --name",
    "db:create:migrate": "bun server/database/console/migrator-cli create --name"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@iconify-json/lucide": "^1.2.72",
    "@nuxt/eslint": "1.10.0",
    "@nuxt/ui": "^4.1.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.208.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.208.0",
    "@opentelemetry/host-metrics": "^0.37.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.64.0",
    "@opentelemetry/instrumentation-http": "^0.208.0",
    "@opentelemetry/instrumentation-ioredis": "^0.56.0",
    "@opentelemetry/instrumentation-pg": "^0.61.1",
    "@opentelemetry/instrumentation-runtime-node": "^0.22.0",
    "@opentelemetry/instrumentation-winston": "^0.53.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@opentelemetry/winston-transport": "^0.19.0",
    "@pinia/nuxt": "0.11.3",
    "ajv": "^8.17.1",
    "bcrypt": "^6.0.0",
    "busboy": "^1.6.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.10",
    "nuxt": "^4.2.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pinia": "^3.0.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "umzug": "^3.8.2",
    "uuid": "^13.0.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "6.2.0",
    "@faker-js/faker": "^10.1.0",
    "@nuxt/test-utils": "^3.19.1",
    "@types/bcrypt": "^6.0.0",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.3",
    "@types/uuid": "^11.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.28.0",
    "eslint-plugin-format": "^1.0.2",
    "happy-dom": "20.0.10",
    "lint-staged": "^16.2.6",
    "playwright-core": "^1.56.0",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "bcrypt"
  ]
}
