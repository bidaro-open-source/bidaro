NODE_ENV=development

SETUP_HOST=http://localhost:3000
SETUP_MAILER_PORT=3002

NUXT_PUBLIC_APP_URL=http://localhost:3000

NUXT_DIAGNOSTIC_TOKEN=hello

NUXT_DB_CONNECTION=postgres
NUXT_DB_HOST=localhost
NUXT_DB_PORT=5432
NUXT_DB_DATABASE=postgres
NUXT_DB_USERNAME=postgres
NUXT_DB_PASSWORD=postgres

NUXT_REDIS_HOST=localhost
NUXT_REDIS_PORT=3003
NUXT_REDIS_USER=
NUXT_REDIS_PASS=

NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=
NUXT_S3_ENDPOINT=http://localhost:9000
NUXT_S3_REGION=auto
NUXT_S3_BUCKET=

NUXT_MAILER_HOST=localhost
NUXT_MAILER_PORT=1025
NUXT_MAILER_USER=null
NUXT_MAILER_PASS=null
NUXT_MAILER_ENCRYPTION=null
NUXT_MAILER_FROM_ADDRESS="noreply@example.dev"
NUXT_MAILER_FROM_NAME="Fake Company"

NUXT_JWT_SECRET=
NUXT_JWT_ACCESS_TTL=
NUXT_JWT_REFRESH_TTL=
NUXT_JWT_REFRESH_SIZE=

NUXT_PASSWORD_HASH_ROUNDS=12
NUXT_PASSWORD_RESET_TTL=86400
NUXT_PASSWORD_RESET_SIZE=128

NUXT_EMAIL_TOKEN_SIZE=64

NUXT_RATE_LIMIT_ENABLED=true
NUXT_CHALLENGE_ENABLED=true

OBSERVABILITY_ENABLED=true
OBSERVABILITY_LOGS_ENABLED=true
OBSERVABILITY_TRACES_ENABLED=true
OBSERVABILITY_METRICS_ENABLED=true
